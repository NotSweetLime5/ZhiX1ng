# Optional physical volume bindings. Defaults create application-owned volumes.
# Set EXTERNAL_VOLUMES=true only when the named volumes already exist.
ZHIXING_EXTERNAL_VOLUMES=false
ZHIXING_PGDATA_VOLUME=zhixing_pgdata
ZHIXING_REDISDATA_VOLUME=zhixing_redisdata
ZHIXING_OBJECTS_VOLUME=zhixing_objects
ZHIXING_ETCDDATA_VOLUME=zhixing_etcddata
ZHIXING_MILVUSDATA_VOLUME=zhixing_milvusdata
ZHIXING_GRAFANADATA_VOLUME=zhixing_grafanadata
